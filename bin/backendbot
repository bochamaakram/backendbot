#!/usr/bin/env node

const fs = require('fs');
const path = require('path');
const readline = require('readline');

// Elegant Terminal Palette (ANSI)
const RED = '\x1b[31m';
const GREEN = '\x1b[32m';
const BLUE = '\x1b[34m';
const PURPLE = '\x1b[35m';
const CYAN = '\x1b[36m';
const YELLOW = '\x1b[33m';
const BOLD = '\x1b[1m';
const DIM = '\x1b[2m';
const NC = '\x1b[0m'; // No Color

// Premium Icons
const CHECK_MARK = '🟢';
const ERROR_X = '🔴';
const INFO_CIRCLE = '🔵';
const SPARKLES = '✨';
const FOLDER = '📁';
const ARROW = '⚡';

// Resolve Source Directory (the parent of 'bin/' where the repo resides)
const SCRIPT_PATH = fs.realpathSync(process.argv[1]);
const SCRIPT_DIR = path.dirname(SCRIPT_PATH);
const SOURCE_DIR = path.dirname(SCRIPT_DIR);

const DEST_DIR = process.cwd();

function printHeader() {
  console.log(`${PURPLE}${BOLD}┌────────────────────────────────────────────────────────┐${NC}`);
  console.log(`${PURPLE}${BOLD}│${NC}  ${SPARKLES}  ${BOLD}BackendBot — Schema Architect CLI${NC}             ${PURPLE}${BOLD}│${NC}`);
  console.log(`${PURPLE}${BOLD}└────────────────────────────────────────────────────────┘${NC}`);
}

function showHelp() {
  printHeader();
  console.log("Easily inject the Back Office architecture schemas into your current project.");
  console.log("");
  console.log(`${BOLD}Usage:${NC}`);
  console.log(`  ${CYAN}backendbot${NC} [command]`);
  console.log("");
  console.log(`${BOLD}Commands:${NC}`);
  console.log(`  ${GREEN}init${NC}      Copy the architecture schemas (${DIM}docs/schema/${NC}) to your current project`);
  console.log(`  ${CYAN}status${NC}    Verify if backendbot schemas are present in this directory`);
  console.log(`  ${YELLOW}help${NC}      Show this interactive guide`);
  console.log("");
  console.log(`${DIM}Source blueprints at: ${BLUE}${SOURCE_DIR}${NC}`);
  console.log("");
}

// Copy directory recursively helper (compatible with all operating systems)
function copyDirSync(src, dest) {
  fs.mkdirSync(dest, { recursive: true });
  const entries = fs.readdirSync(src, { withFileTypes: true });

  for (let entry of entries) {
    const srcPath = path.join(src, entry.name);
    const destPath = path.join(dest, entry.name);

    if (entry.isDirectory()) {
      copyDirSync(srcPath, destPath);
    } else {
      fs.copyFileSync(srcPath, destPath);
    }
  }
}

function askQuestion(query) {
  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout,
  });

  return new Promise((resolve) => rl.question(query, (ans) => {
    rl.close();
    resolve(ans);
  }));
}

async function initSchemas() {
  printHeader();

  const sourceSchemaDir = path.join(SOURCE_DIR, 'docs', 'schema');
  if (!fs.existsSync(sourceSchemaDir)) {
    console.log(`${ERROR_X} ${RED}${BOLD}Error:${NC} Source schemas not found at: ${BLUE}${sourceSchemaDir}${NC}`);
    console.log("Please make sure your backendbot repository is complete.");
    process.exit(1);
  }

  // Avoid copying onto itself
  const normalizedDest = path.normalize(DEST_DIR);
  const normalizedSource = path.normalize(SOURCE_DIR);
  if (normalizedDest === normalizedSource || normalizedDest.startsWith(path.join(normalizedSource, 'docs'))) {
    console.log(`${ERROR_X} ${RED}${BOLD}Error:${NC} You are running this command inside the BackendBot source repository.`);
    console.log(`Run this command inside the project where you want to ${BOLD}add${NC} the schemas!`);
    process.exit(1);
  }

  console.log(`${INFO_CIRCLE} ${CYAN}Preparing to inject schemas to:${NC} ${BOLD}${DEST_DIR}${NC}`);

  const targetSchemaDir = path.join(DEST_DIR, 'docs', 'schema');
  if (fs.existsSync(targetSchemaDir)) {
    console.log(`\n${YELLOW}⚠️  Warning:${NC} 'docs/schema' already exists in this project.`);
    const confirm = await askQuestion(`👉 Do you want to overwrite existing schema files? (y/N) `);
    console.log(""); // New line
    if (!confirm.toLowerCase().startsWith('y')) {
      console.log(`${ERROR_X} ${RED}Action aborted by user.${NC}`);
      process.exit(1);
    }
  }

  try {
    console.log(`${ARROW} Syncing schemas...`);
    copyDirSync(sourceSchemaDir, targetSchemaDir);

    console.log(`\n${CHECK_MARK} ${GREEN}${BOLD}Success! Backend schemas successfully integrated!${NC}`);
    console.log(`\n${BOLD}Generated Blueprint Files:${NC}`);
    const files = fs.readdirSync(targetSchemaDir);
    files.forEach(file => {
      console.log(`  ${FOLDER} ${file}`);
    });
    console.log(`\n${SPARKLES} Your AI agents and developers now have an authoritative blueprint at ${CYAN}docs/schema/${NC}.`);
  } catch (err) {
    console.log(`${ERROR_X} ${RED}Error: Failed to copy schema files.${NC}`);
    console.error(err);
    process.exit(1);
  }
}

function checkStatus() {
  printHeader();
  const targetSchemaDir = path.join(DEST_DIR, 'docs', 'schema');
  if (fs.existsSync(targetSchemaDir)) {
    const files = fs.readdirSync(targetSchemaDir);
    console.log(`${CHECK_MARK} ${GREEN}BackendBot schemas are ${BOLD}INSTALLED${NC} in this project.${NC}`);
    console.log(`  ${FOLDER} Location:   ${CYAN}${targetSchemaDir}${NC}`);
    console.log(`  ${ARROW} File Count: ${BOLD}${files.length}${NC} documentation specifications`);
  } else {
    console.log(`${ERROR_X} ${RED}BackendBot schemas are ${BOLD}NOT${NC} installed in this project.${NC}`);
    console.log(`👉 Run ${GREEN}backendbot init${NC} inside this directory to integrate them.`);
  }
}

async function main() {
  const arg = process.argv[2];
  switch (arg) {
    case 'init':
      await initSchemas();
      break;
    case 'status':
      checkStatus();
      break;
    case 'help':
    case '--help':
    case '-h':
      showHelp();
      break;
    case undefined:
      // Interactive default: run status if installed, otherwise init
      const targetSchemaDir = path.join(DEST_DIR, 'docs', 'schema');
      if (fs.existsSync(targetSchemaDir)) {
        checkStatus();
      } else {
        await initSchemas();
      }
      break;
    default:
      console.log(`${RED}Unknown command: ${arg}${NC}`);
      showHelp();
      process.exit(1);
  }
}

main();
